{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next/dev/production/types/**/*.ts",
    ".next/dev/production/dev/types/**/*.ts",
    ".next/dev/development/types/**/*.ts",
    ".next/dev/development/dev/types/**/*.ts",
    ".next/prod/production/types/**/*.ts",
    ".next/prod/production/dev/types/**/*.ts",
    ".next/prod/development/types/**/*.ts",
    ".next/prod/development/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "firebase/functions"]
}
