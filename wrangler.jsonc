{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vishu-renewal-web",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vishu-renewal-web"
    }
  ],
  "vars": {
    "SITE_URL": "https://vishu-renewal-web.salon-vishu.workers.dev/",
    "VISHU_ENV": "prod",
    "VISHU_NEXT_MODE": "production",
    "NEXT_PUBLIC_VISHU_ENV": "prod",
    "NEXT_PUBLIC_FIREBASE_API_KEY": "AIzaSyBzaFzx1tztRqICaeYEwTIlY8nWkDW8iKc",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "salon-vishu",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "salon-vishu.firebaseapp.com",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "salon-vishu.appspot.com",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "689319200957",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "1:689319200957:web:6d2270d4f90e13896a4fd4"
  }
}
